# Server-only token from football-data.org. Never commit the real value.
FOOTBALL_DATA_TOKEN=your_server_token_here
PORT=8787

# Required before Pro calendar export can be made available. These belong only in deployment secrets.
# The verifier must derive the user from an authenticated server-side session/token and return an
# active, uncancelled, unrevoked subscription with a future expiresAt for product calendar_export.
ENTITLEMENT_VERIFIER_URL=https://your-entitlement-service.example/verify
ENTITLEMENT_VERIFIER_TOKEN=replace_with_a_server_to_server_secret
